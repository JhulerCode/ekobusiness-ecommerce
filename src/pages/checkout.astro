---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CheckoutForm from '@/components/CheckoutForm.vue'
import checkoutHero from '@/assets/home/blend.webp'
import { get } from '@/lib/api.js'
import empresa from '@/data/company.js'

const res = await get('sistema', {
    qry: [
        'documentos_identidad',
        'entrega_tipos',
        'comprobante_tipos',
        'pago_metodos',
    ],
})

console.log('Checkout data:', res.data)

if (res.code == 0) {
    var {
        documentos_identidad,
        entrega_tipos,
        comprobante_tipos,
        pago_metodos,
    } = res.data
}
---

<BaseLayout
    title="Finaliza tu compra | SUNKA Herbal Tea"
    description="Completa tus datos de entrega y elige tu método de pago para finalizar tu compra SUNKA."
>
    <section
        class="relative min-h-[480px] w-full overflow-hidden bg-sunka-ink text-sunka-white md:min-h-[430px]"
    >
        <div class="absolute inset-0" aria-hidden="true">
            <img
                src={checkoutHero.src}
                alt=""
                class="checkout-hero-image h-full w-full object-cover object-center"
            />
            <div
                class="absolute inset-0 bg-[linear-gradient(180deg,rgba(9,8,6,1)_0%,rgba(9,8,6,.98)_34%,rgba(9,8,6,.82)_58%,rgba(9,8,6,.18)_100%)] md:bg-[linear-gradient(90deg,rgba(9,8,6,1)_0%,rgba(9,8,6,.92)_42%,rgba(9,8,6,.46)_68%,rgba(9,8,6,.12)_100%)]"
            ></div>
        </div>

        <div
            class="relative z-10 mx-auto flex min-h-[480px] max-w-7xl items-start px-5 pt-28 md:min-h-[430px] md:items-center md:px-8 md:pt-24"
        >
            <div class="max-w-2xl">
                <a
                    href="/tienda"
                    class="mb-6 inline-flex text-xs text-sunka-white/68 transition-colors hover:text-sunka-brass-light"
                >
                    ← Volver a la tienda
                </a>
                <p
                    class="mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-sunka-brass-light/90"
                >
                    Tu ritual, a un paso
                </p>
                <h1
                    class="max-w-xl font-heading text-3xl font-semibold leading-[1.05] text-sunka-white md:text-5xl"
                >
                    Finaliza tu compra
                </h1>
                <p class="mt-6 max-w-md text-base leading-relaxed text-sunka-white/88 md:text-lg">
                    Completa tus datos con tranquilidad. Tu pedido está reservado mientras avanzas.
                </p>
            </div>
        </div>
    </section>

    <main class="checkout-page">
        <CheckoutForm
            client:load
            empresa={empresa}
            pago_metodos={pago_metodos}
            documentos_identidad={documentos_identidad}
            entrega_tipos={entrega_tipos}
            comprobante_tipos={comprobante_tipos}
        />
    </main>
</BaseLayout>

<style>
    .checkout-hero-image {
        animation: checkoutHeroZoom 12s ease-in-out infinite alternate;
    }

    .checkout-page {
        padding: 28px 24px 120px;
        background: var(--sunka-cream);
    }

    @keyframes checkoutHeroZoom {
        from { transform: scale(1); }
        to { transform: scale(1.06); }
    }

    @media (prefers-reduced-motion: reduce) {
        .checkout-hero-image { animation: none; }
    }

    @media (max-width: 720px) {
        .checkout-page { padding: 16px 12px 48px; }
    }
</style>
