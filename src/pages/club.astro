---
import BaseLayout from '@/layouts/BaseLayout.astro'
import NewsLetterForm from '@/components/NewsLetterForm.vue'
import ArtisanTeaIcon from '@/assets/icons/icon-artisan-tea.astro'
import BriefcaseIcon from '@/assets/icons/icon-briefcase.astro'
import GiftIcon from '@/assets/icons/icon-gift.astro'
import UsersIcon from '@/assets/icons/icon-users.astro'
import hero from '@/assets/club/hero.png'
import apparel from '@/assets/club/apparel.png'
import ritualSet from '@/assets/club/ritual-set.png'

const categories = [
    {
        eyebrow: '01 · Vestir',
        title: 'Polos y gorras',
        description: 'Piezas esenciales con identidad Sunka.',
        Icon: UsersIcon,
    },
    {
        eyebrow: '02 · Para llevar',
        title: 'Tomatodos',
        description: 'Tu bebida favorita siempre contigo.',
        Icon: BriefcaseIcon,
    },
    {
        eyebrow: '03 · Tu ritual',
        title: 'Teteras y tazas',
        description: 'Diseño funcional para una mejor taza.',
        Icon: ArtisanTeaIcon,
    },
    {
        eyebrow: '04 · Tu espacio',
        title: 'Velas y objetos',
        description: 'Detalles que transforman el ambiente.',
        Icon: GiftIcon,
    },
]

const products = [
    {
        name: 'Polo Esencial',
        detail: 'Algodón premium · Verde bosque',
        price: 'S/ 79.90',
        image: apparel,
        position: 'object-[20%_22%]',
        badge: 'Nuevo',
    },
    {
        name: 'Gorra Everyday',
        detail: 'Algodón lavado · Ajustable',
        price: 'S/ 59.90',
        image: apparel,
        position: 'object-[88%_82%]',
        badge: 'Nuevo',
    },
    {
        name: 'Tomatodo Daily',
        detail: 'Acero inoxidable · 500 ml',
        price: 'S/ 89.90',
        image: ritualSet,
        position: 'object-[16%_45%]',
        badge: 'Club',
    },
    {
        name: 'Tetera Ceremony',
        detail: 'Cerámica artesanal · 750 ml',
        price: 'S/ 119.90',
        image: ritualSet,
        position: 'object-[68%_52%]',
        badge: 'Club',
    },
]

const benefits = [
    {
        number: '01 · Primero',
        title: 'Acceso anticipado',
        description: 'Conoce antes las nuevas líneas, drops y colaboraciones.',
    },
    {
        number: '02 · Exclusivo',
        title: 'Piezas para miembros',
        description: 'Ediciones limitadas y beneficios especiales durante el año.',
    },
    {
        number: '03 · Contigo',
        title: 'Experiencias Sunka',
        description: 'Contenido, rituales y encuentros para disfrutar mejor el té.',
    },
]
---

<BaseLayout
    title="Club Sunka | SUNKA Herbal Tea"
    description="Objetos, piezas y experiencias para llevar el ritual Sunka más allá de la taza."
>
    <section class="club-hero relative min-h-[690px] w-full overflow-hidden bg-sunka-ink text-sunka-white md:min-h-[650px]">
        <div class="absolute inset-0" aria-hidden="true">
            <img
                src={hero.src}
                alt="Ritual de té Sunka"
                class="club-hero-image h-full w-full object-cover object-[64%_center]"
            />
            <div
                class="absolute inset-0 bg-[linear-gradient(180deg,rgba(5,10,7,1)_0%,rgba(5,10,7,.98)_34%,rgba(5,10,7,.82)_58%,rgba(5,10,7,.18)_100%)] md:bg-[linear-gradient(90deg,rgba(5,10,7,1)_0%,rgba(5,10,7,.92)_42%,rgba(5,10,7,.46)_68%,rgba(5,10,7,.12)_100%)]"
            ></div>
        </div>
        <div
            class="relative z-10 mx-auto flex min-h-[690px] max-w-7xl items-start px-5 pt-28 md:min-h-[650px] md:items-center md:px-8 md:pt-24"
        >
            <div class="max-w-2xl">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-sunka-brass-light/90">
                    Club Sunka · The soul of tea
                </p>
                <h1 class="max-w-xl font-heading text-3xl font-semibold leading-[1.05] md:text-5xl">
                    Lleva Sunka más allá de la taza.
                </h1>
                <p class="mt-6 max-w-md text-base leading-relaxed text-sunka-white/88 md:text-lg">
                    Objetos creados para acompañarte: lo que vistes, lo que llevas y la forma en que
                    disfrutas cada momento.
                </p>
                <div class="mt-9 flex flex-col gap-3 sm:flex-row">
                    <a
                        href="#coleccion"
                        class="club-button club-hero-button-primary"
                    >
                        Explorar colección
                    </a>
                    <a
                        href="#beneficios"
                        class="club-button club-hero-button-secondary"
                    >
                        Conoce el club
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-sunka-cream py-12 md:py-16">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
            <div class="grid gap-4 fade-up md:grid-cols-2 md:items-end">
                <div>
                    <p class="section-kicker">Objetos para tu ritmo</p>
                    <h2 class="section-title">Diseñados para acompañarte.</h2>
                </div>
                <p class="max-w-lg text-sm leading-relaxed text-sunka-ink/68 md:justify-self-end">
                    Piezas útiles, contemporáneas y duraderas para tu día a día.
                </p>
            </div>

            <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                {
                    categories.map(({ eyebrow, title, description, Icon }, index) => (
                        <article
                            class={`border border-sunka-sand bg-sunka-white p-5 fade-up delay-${Math.min(index, 3)}`}
                        >
                            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-sunka-forest text-sunka-brass-light">
                                <Icon class="h-5 w-5" />
                            </span>
                            <p class="section-kicker mt-5">
                                {eyebrow}
                            </p>
                            <h3 class="mt-2 font-heading text-base font-semibold leading-tight text-sunka-ink md:text-lg">
                                {title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-sunka-ink/68">{description}</p>
                            <a
                                href="#coleccion"
                                class="mt-4 inline-flex text-[11px] font-semibold uppercase tracking-[0.12em] text-sunka-ink transition hover:text-sunka-brass"
                            >
                                Explorar →
                            </a>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <section id="coleccion" class="scroll-mt-20 bg-sunka-white py-12 md:py-16">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
            <div class="flex items-end justify-between gap-6 fade-up">
                <div>
                    <p class="section-kicker">Primer drop · Edición 01</p>
                    <h2 class="section-title">Esenciales Club Sunka.</h2>
                </div>
                <a
                    href="/tienda"
                    class="hidden text-xs font-semibold uppercase tracking-[0.1em] text-sunka-ink transition hover:text-sunka-brass sm:block"
                >
                    Ver todos los productos →
                </a>
            </div>

            <div class="mt-8 grid grid-cols-2 gap-x-3 gap-y-8 lg:grid-cols-4 lg:gap-x-4">
                {
                    products.map((product, index) => (
                        <article class={`group fade-up delay-${Math.min(index, 3)}`}>
                            <a
                                href="/tienda"
                                class="relative block aspect-[.78] overflow-hidden bg-sunka-cream"
                            >
                                <img
                                    src={product.image.src}
                                    alt={product.name}
                                    class={`h-full w-full scale-[1.65] object-cover ${product.position} transition duration-700 group-hover:scale-[1.72]`}
                                />
                                <span class="absolute left-3 top-3 bg-sunka-forest px-3 py-1.5 text-[8px] font-semibold uppercase tracking-[0.18em] text-sunka-white">
                                    {product.badge}
                                </span>
                            </a>
                            <h3 class="mt-3 font-heading text-sm font-semibold leading-tight text-sunka-ink md:text-base">
                                {product.name}
                            </h3>
                            <p class="mt-1 text-[10px] text-sunka-stone">{product.detail}</p>
                            <p class="mt-4 text-sm font-semibold text-sunka-ink">{product.price}</p>
                            <a href="/tienda" class="mt-4 inline-flex text-[11px] font-semibold uppercase tracking-[0.1em] text-sunka-ink transition hover:text-sunka-brass">
                                Ver producto →
                            </a>
                        </article>
                    ))
                }
            </div>

            <div
                class="mt-10 grid gap-3 border-t border-sunka-sand pt-4 text-xs text-sunka-stone sm:grid-cols-3"
            >
                <p>Envío gratis desde S/ 175</p>
                <p class="sm:text-center">Cambios fáciles dentro de 15 días</p>
                <p class="sm:text-right">Unidades limitadas por colección</p>
            </div>
        </div>
    </section>

    <section class="bg-sunka-forest py-12 text-sunka-white md:py-16">
        <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 md:grid-cols-2 md:px-8 lg:gap-16">
            <div class="relative fade-up">
                <div class="absolute -left-3 -top-3 h-full w-full border border-sunka-brass/70"></div>
                <img
                    src={apparel.src}
                    alt="Prendas esenciales Club Sunka"
                    class="relative aspect-[1.12] w-full object-cover"
                />
            </div>
            <div class="fade-up delay-1">
                <p class="section-kicker">Una extensión de la marca</p>
                <h2 class="section-title section-title-light max-w-lg">
                    No es merchandising. Es una forma de llevar la marca contigo.
                </h2>
                <p class="mt-4 max-w-lg text-sm leading-relaxed text-sunka-white/78 md:text-base">
                    Cada pieza nace de la misma idea que nuestros tés: calidad, utilidad y una
                    estética pensada para permanecer.
                </p>
                <ul class="mt-6 max-w-xl divide-y divide-sunka-white/10 border-y border-sunka-white/10">
                    <li class="club-step">
                        <span>01</span>
                        <div>
                            <strong>Materiales elegidos para durar.</strong>
                        </div>
                    </li>
                    <li class="club-step">
                        <span>02</span>
                        <div>
                            <strong>Diseño simple, útil y reconocible.</strong>
                        </div>
                    </li>
                </ul>
                <a
                    href="#coleccion"
                    class="club-button club-button-gold mt-7 w-full sm:w-fit"
                >
                    Conoce la colección
                </a>
            </div>
        </div>
    </section>

    <section class="bg-sunka-cream py-12 md:py-16">
        <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 md:grid-cols-2 md:px-8 lg:gap-16">
            <div class="relative fade-up">
                <div class="absolute -bottom-3 -left-3 h-full w-full border border-sunka-brass/60"></div>
                <img
                    src={ritualSet.src}
                    alt="Tomatodo, tetera, taza y vela para un ritual Sunka"
                    class="relative aspect-square w-full object-cover"
                />
            </div>
            <div class="fade-up delay-1">
                <p class="section-kicker">Combina a tu manera</p>
                <h2 class="section-title">
                    Arma tu propio ritual Sunka.
                </h2>
                <p class="mt-4 max-w-lg text-sm leading-relaxed text-sunka-ink/68 md:text-base">
                    Elige tres piezas de la colección y crea un set pensado para tu rutina o para
                    regalar.
                </p>
                <ol class="mt-6 divide-y divide-sunka-sand border-y border-sunka-sand">
                    <li class="club-step club-step-light">
                        <span>01</span>
                        <div>
                            <strong>Elige tu pieza principal</strong>
                            <small>Tetera, tomatodo o taza.</small>
                        </div>
                    </li>
                    <li class="club-step club-step-light">
                        <span>02</span>
                        <div>
                            <strong>Añade un objeto para tu espacio</strong>
                            <small>Vela, taza o accesorio.</small>
                        </div>
                    </li>
                    <li class="club-step club-step-light">
                        <span>03</span>
                        <div>
                            <strong>Completa con tu blend favorito</strong>
                            <small>Un set listo para disfrutar.</small>
                        </div>
                    </li>
                </ol>
                <a
                    href="/tienda"
                    class="club-button club-button-gold mt-7 w-full sm:w-fit"
                >
                    Crear mi set
                </a>
            </div>
        </div>
    </section>

    <section id="beneficios" class="scroll-mt-20 bg-sunka-white py-10 md:py-14">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
            <div class="text-center fade-up">
                <p class="section-kicker">Ser parte del club</p>
                <h2 class="section-title">Más cerca de lo que viene.</h2>
                <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-sunka-ink/68">
                    Una comunidad para quienes quieren vivir Sunka dentro y fuera de la taza.
                </p>
            </div>
            <div class="mx-auto mt-8 grid max-w-5xl gap-3 md:grid-cols-3">
                {
                    benefits.map((benefit, index) => (
                        <article
                            class={`border border-sunka-sand bg-sunka-cream p-5 fade-up delay-${index}`}
                        >
                            <p class="text-[9px] font-semibold uppercase tracking-[0.18em] text-sunka-brass">
                                {benefit.number}
                            </p>
                            <h3 class="mt-3 font-heading text-base font-semibold leading-tight text-sunka-ink md:text-lg">
                                {benefit.title}
                            </h3>
                            <p class="mt-2 text-sm leading-relaxed text-sunka-ink/68">
                                {benefit.description}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="relative overflow-hidden bg-sunka-ink py-14 text-sunka-white md:py-20">
        <img
            src={hero.src}
            alt=""
            class="absolute inset-0 h-full w-full object-cover object-right opacity-55"
        />
        <div
            class="absolute inset-0 bg-[linear-gradient(90deg,rgba(4,15,9,.99)_0%,rgba(4,15,9,.93)_48%,rgba(4,15,9,.18)_100%)]"
        ></div>
        <div class="relative mx-auto max-w-7xl px-5 md:px-8">
            <div class="max-w-xl fade-up">
                <p class="section-kicker">Únete a Club Sunka</p>
                <h2 class="section-title section-title-light mt-3">
                    La próxima colección empieza aquí.
                </h2>
                <p class="mt-4 max-w-lg text-sm leading-relaxed text-sunka-white/78 md:text-base">
                    Recibe acceso anticipado, lanzamientos y contenido Sunka. Sin membresía pagada,
                    solo beneficios que valen la pena.
                </p>
                <div class="mt-7 max-w-lg">
                    <NewsLetterForm
                        client:load
                        theme="dark"
                        variant="home"
                        showPrivacy={false}
                    />
                </div>
                <p class="mt-4 text-[9px] leading-4 text-sunka-white/42">
                    Al registrarte aceptas recibir novedades de Sunka. Puedes salir cuando quieras.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    @reference '../styles/global.css';

    .section-kicker {
        @apply text-[11px] font-semibold uppercase tracking-[0.28em] text-sunka-brass;
    }

    .section-title {
        @apply mt-2 font-heading text-2xl font-semibold leading-tight text-sunka-ink md:text-3xl;
    }

    .section-title-light {
        @apply text-sunka-white;
    }

    .club-button {
        @apply inline-flex h-11 items-center justify-center border px-6 text-[12px] font-semibold uppercase tracking-[0.12em] transition-all duration-300;
    }

    .club-hero-button-primary {
        @apply border-sunka-brass bg-sunka-brass text-sunka-white hover:bg-sunka-brass-light hover:text-sunka-ink;
    }

    .club-hero-button-secondary {
        @apply border-sunka-white/55 text-sunka-white hover:border-sunka-white hover:bg-sunka-white hover:text-sunka-ink;
    }

    .club-button-gold {
        @apply border-sunka-brass bg-sunka-brass text-sunka-ink hover:border-sunka-brass-light hover:bg-sunka-brass-light;
    }

    .club-step {
        @apply grid grid-cols-[2rem_1fr] gap-3 py-4;
    }

    .club-step > span {
        @apply pt-1 text-[11px] font-semibold tracking-[0.14em] text-sunka-brass;
    }

    .club-step strong {
        @apply block font-heading text-sm font-semibold md:text-base;
    }

    .club-step small {
        @apply mt-1 block text-sm leading-relaxed text-sunka-white/68;
    }

    .club-step-light small {
        @apply text-sunka-ink/68;
    }

    .club-hero-image {
        animation: clubHeroZoom 12s ease-in-out infinite alternate;
    }

    @keyframes clubHeroZoom {
        from {
            transform: scale(1);
        }

        to {
            transform: scale(1.06);
        }
    }

    @media (max-width: 767px) {
        .club-hero {
            min-height: 690px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .club-hero-image {
            animation: none;
        }
    }
</style>
