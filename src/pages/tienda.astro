---
import BaseLayout from '@/layouts/BaseLayout.astro'
import TiendaCatalog from '@/components/tienda/TiendaCatalog.vue'
import Beneficios from '@/components/home/Beneficios.astro'
import bannerTienda from '@/assets/banner1.webp'
import originImage from '@/assets/origen/proposito2.webp'
import { get, formatProductos } from '@/lib/api.js'
import { momentos } from '@/data/momentos.js'

//--- Load productos ---//
const qryProductos = {
    fltr: {
        activo: { op: 'Es', val: true },
        is_ecommerce: { op: 'Es', val: true },
    },
    cols: ['id', 'nombre', 'linea', 'ecommerce_data'],
    incl: ['linea1'],
}
const resProductos = await get('productos', { qry: qryProductos })
const productos = formatProductos(resProductos.data)

//--- Set líneas ---//
const lineas = []
for (const a of productos) {
    if (a.linea1) {
        const i = lineas.findIndex((b) => b.id == a.linea)
        if (i === -1) {
            lineas.push(a.linea1)
        }
    }
}

const collator = new Intl.Collator('es', { sensitivity: 'base' })
lineas.sort((a, b) => collator.compare(a.nombre, b.nombre))
const momentosOrdenados = [...momentos].sort((a, b) => collator.compare(a.titulo, b.titulo))
---

<BaseLayout
    title="Tienda | SUNKA Herbal Tea"
    description="Explora nuestra colección completa de infusiones y tés naturales SUNKA. Disponibles para compra online con envío a todo el Perú."
>
    <section
        class="relative min-h-[480px] w-full overflow-hidden bg-sunka-ink text-sunka-white md:min-h-[430px]"
    >
        <div class="absolute inset-0" aria-hidden="true">
            <img
                src={bannerTienda.src}
                alt=""
                class="linea-hero-image h-full w-full object-cover object-center"
            />
            <div
                class="absolute inset-0 bg-[linear-gradient(180deg,rgba(9,8,6,1)_0%,rgba(9,8,6,.98)_34%,rgba(9,8,6,.82)_58%,rgba(9,8,6,.18)_100%)] md:bg-[linear-gradient(90deg,rgba(9,8,6,1)_0%,rgba(9,8,6,.92)_42%,rgba(9,8,6,.46)_68%,rgba(9,8,6,.12)_100%)]"
            ></div>
        </div>

        <div
            class="relative z-10 mx-auto flex min-h-[480px] max-w-7xl items-start px-5 pt-28 md:min-h-[430px] md:items-center md:px-8 md:pt-24"
        >
            <div class="max-w-2xl">
                <p
                    class="mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-sunka-brass-light/90"
                >
                    Colección completa
                </p>
                <h1
                    class="max-w-xl font-heading text-3xl font-semibold leading-[1.05] text-sunka-white md:text-5xl"
                >
                    Nuestra Tienda
                </h1>
                <p class="mt-6 max-w-md text-base leading-relaxed text-sunka-white/88 md:text-lg">
                    Descubre la pureza de los Andes en cada taza. Desde mezclas clásicas hasta
                    nuestras creaciones exclusivas, cada producto Sunka es una invitación al
                    bienestar.
                </p>
            </div>
        </div>
    </section>
    <TiendaCatalog
        client:load
        productos={productos}
        lineas={lineas}
        momentos={momentosOrdenados}
    />
    <section class="mx-auto max-w-7xl px-5 pb-16 md:px-8 md:pb-24">
        <div class="tienda-origin-banner relative min-h-[310px] overflow-hidden rounded-lg bg-sunka-cream md:min-h-[250px]">
            <img
                src={originImage.src}
                alt="Preparación artesanal de una infusión SUNKA"
                class="absolute inset-0 h-full w-full object-cover object-[58%_center]"
            />
            <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(245,240,231,.98)_0%,rgba(245,240,231,.91)_30%,rgba(245,240,231,.35)_58%,rgba(245,240,231,.04)_100%)]"></div>
            <div class="relative z-10 flex min-h-[310px] max-w-lg flex-col justify-center px-6 py-10 md:min-h-[250px] md:px-8 md:py-8">
                <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-sunka-olive">
                    El ritual comienza con el origen
                </p>
                <h2 class="mt-3 max-w-sm font-heading text-3xl font-semibold leading-tight text-sunka-ink md:text-4xl">
                    Cada mezcla nace de una selección cuidadosa.
                </h2>
                <a
                    href="/origen"
                    class="mt-6 inline-flex items-center gap-3 text-xs font-semibold text-sunka-ink transition-colors hover:text-sunka-olive"
                >
                    Conoce nuestro origen <span aria-hidden="true" class="text-base">→</span>
                </a>
            </div>
        </div>
    </section>
    <Beneficios />
</BaseLayout>

<style>
    .linea-hero-image {
        animation: lineaHeroZoom 12s ease-in-out infinite alternate;
    }

    @keyframes lineaHeroZoom {
        from {
            transform: scale(1);
        }

        to {
            transform: scale(1.06);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .linea-hero-image {
            animation: none;
        }
    }
</style>
