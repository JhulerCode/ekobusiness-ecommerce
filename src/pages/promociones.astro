---
import BaseLayout from '@/layouts/BaseLayout.astro'
import promotionsBanner from '@/assets/promociones/banner.webp'
import {
    CHECKOUT_PROMOTION_RULES,
    CLUB_FREE_SHIPPING_MINIMUM,
    GENERAL_FREE_SHIPPING_MINIMUM,
    getPromotionBenefits,
    getPromotionRequirementText,
    isMixedPromotion,
} from '@/lib/checkout-promotions'

const generalPromotions = CHECKOUT_PROMOTION_RULES.filter((rule) => rule.audience === 'general')
const clubPromotions = CHECKOUT_PROMOTION_RULES.filter((rule) => rule.audience === 'club')

const promotionGroups = [
    {
        id: 'general',
        eyebrow: 'Para todos',
        title: 'Promociones generales',
        description: `Compra desde S/ ${GENERAL_FREE_SHIPPING_MINIMUM} o completa una combinación para obtener envío gratis.`,
        promotions: generalPromotions,
    },
    {
        id: 'club',
        eyebrow: 'Con una cuenta SUNKA',
        title: 'Promociones Club',
        description: `Inicia sesión para acceder al envío gratis desde S/ ${CLUB_FREE_SHIPPING_MINIMUM} y a beneficios exclusivos en combinaciones seleccionadas.`,
        promotions: clubPromotions,
    },
]
---

<BaseLayout
    title="Promociones | SUNKA Herbal Tea"
    description="Conoce las promociones, packs por línea y beneficios Club SUNKA disponibles para compras con envío en Lima Metropolitana."
>
    <section class="relative min-h-[480px] w-full overflow-hidden bg-sunka-ink text-sunka-white md:min-h-[430px]">
        <div class="absolute inset-0" aria-hidden="true">
            <img
                src={promotionsBanner.src}
                alt=""
                class="linea-hero-image h-full w-full object-cover object-center"
            />
            <div
                class="absolute inset-0 bg-[linear-gradient(180deg,rgba(9,8,6,1)_0%,rgba(9,8,6,.98)_34%,rgba(9,8,6,.82)_58%,rgba(9,8,6,.18)_100%)] md:bg-[linear-gradient(90deg,rgba(9,8,6,1)_0%,rgba(9,8,6,.92)_42%,rgba(9,8,6,.46)_68%,rgba(9,8,6,.12)_100%)]"
            ></div>
        </div>
        <div class="relative z-10 mx-auto flex min-h-[480px] max-w-7xl items-start px-5 pt-28 md:min-h-[430px] md:items-center md:px-8 md:pt-24">
            <div class="max-w-2xl">
                <p class="mb-4 text-xs font-semibold uppercase tracking-[0.28em] text-sunka-brass-light/90">
                    Beneficios vigentes
                </p>
                <h1 class="max-w-xl font-heading text-3xl font-semibold leading-[1.05] text-sunka-white md:text-5xl">
                    Combina tus favoritos y recibe más de SUNKA
                </h1>
                <p class="mt-6 max-w-md text-base leading-relaxed text-sunka-white/88 md:text-lg">
                    Todas las cantidades son mínimas y puedes elegir cualquier producto que
                    pertenezca a la línea y presentación indicadas.
                </p>
            </div>
        </div>
    </section>

    <section class="bg-[#e9e7e1] py-9 md:py-11">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
            <header class="text-center">
                <h2 class="font-heading text-2xl font-semibold leading-tight text-sunka-ink md:text-3xl">
                    Envío gratis en Lima Metropolitana
                </h2>
                <p class="mt-1 text-sm text-sunka-ink/70">
                    El monto mínimo depende de si compras como invitado o con una cuenta SUNKA.
                </p>
            </header>

            <div class="mx-auto mt-9 grid max-w-4xl gap-5 md:mt-10 md:grid-cols-2">
                <article class="rounded-[6px] border border-sunka-sand bg-sunka-white px-5 py-6 md:px-6">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-sunka-brass">
                        Compra general
                    </p>
                    <h3 class="mt-2 font-heading text-xl font-semibold leading-tight text-sunka-ink md:text-2xl">
                        Envío gratis al comprar S/ {GENERAL_FREE_SHIPPING_MINIMUM} o más
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-sunka-ink/68">
                        Si ninguna combinación se cumple, tu compra obtiene envío gratis al alcanzar
                        el monto mínimo general.
                    </p>
                </article>
                <article class="rounded-[6px] border border-sunka-brass/35 bg-[#fff8e8] px-5 py-6 md:px-6">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-sunka-brass">
                        Compra con cuenta SUNKA
                    </p>
                    <h3 class="mt-2 font-heading text-xl font-semibold leading-tight text-sunka-ink md:text-2xl">
                        Envío gratis al comprar S/ {CLUB_FREE_SHIPPING_MINIMUM} o más
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-sunka-ink/68">
                        Crear tu cuenta es totalmente gratis. Inicia sesión antes de realizar tu
                        pedido para acceder a este monto mínimo especial.
                    </p>
                    <a
                        href="/account"
                        class="mt-5 inline-flex h-10 items-center justify-center border border-sunka-ink/22 px-5 text-[12px] font-semibold uppercase tracking-[0.12em] text-sunka-ink transition-colors duration-300 hover:border-sunka-brass hover:bg-sunka-brass hover:text-sunka-white"
                    >
                        Iniciar sesión o crear una cuenta
                    </a>
                </article>
            </div>
        </div>
    </section>

    {
        promotionGroups.map((group, groupIndex) => (
            <section
                id={group.id}
                class:list={[
                    'scroll-mt-24 py-12 text-sunka-ink md:py-16',
                    groupIndex % 2 === 0 ? 'bg-sunka-white' : 'bg-sunka-cream',
                ]}
            >
                <div class="mx-auto max-w-7xl px-5 md:px-8">
                    <header class="mb-8 flex flex-col gap-4 md:mb-10 md:flex-row md:items-end md:justify-between">
                        <div>
                            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-sunka-brass">
                            {group.eyebrow}
                            </p>
                            <h2 class="mt-2 font-heading text-3xl font-semibold leading-tight md:text-4xl">
                                {group.title}
                            </h2>
                            <p class="mt-2 max-w-xl text-sm leading-relaxed text-sunka-ink/68 md:text-base">
                                {group.description}
                            </p>
                        </div>
                        <a
                            href="/tienda"
                            class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em] text-sunka-ink transition hover:text-sunka-brass"
                        >
                            Ver toda la tienda <span aria-hidden="true">→</span>
                        </a>
                    </header>

                    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3 lg:gap-7">
                        {group.promotions.map((promotion) => (
                            <article class="flex h-full flex-col rounded-[6px] border border-sunka-sand bg-sunka-white p-5 transition duration-300 hover:border-sunka-brass/55 hover:shadow-[0_20px_50px_rgba(9,8,6,.08)] md:p-6">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sunka-brass">
                                            {isMixedPromotion(promotion) ? 'Combinación surtida' : 'Pack por línea'}
                                        </p>
                                        <h3 class="mt-2 font-heading text-xl font-semibold leading-tight text-sunka-ink md:text-2xl">
                                            {promotion.name}
                                        </h3>
                                    </div>
                                    {promotion.mysteryBox && (
                                        <span class="shrink-0 rounded-full bg-sunka-brass/10 px-2.5 py-1 text-[10px] font-semibold text-sunka-brass">
                                            + sorpresa
                                        </span>
                                    )}
                                </div>
                                <p class="mt-3 text-sm leading-relaxed text-sunka-ink/68">
                                    Compra al menos {getPromotionRequirementText(promotion)}.
                                </p>
                                <ul class="mt-3 flex flex-wrap gap-2">
                                    {getPromotionBenefits(promotion).map((benefit) => (
                                        <li class="rounded-full bg-sunka-cream px-3 py-1 text-[10px] font-semibold text-sunka-ink">
                                            {benefit.label}
                                        </li>
                                    ))}
                                </ul>
                            </article>
                        ))}
                    </div>
                </div>
            </section>
        ))
    }

    <section class="bg-sunka-forest py-12 text-sunka-white md:py-16">
        <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 md:flex-row md:items-end md:justify-between md:px-8">
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-sunka-brass-light">
                    Importante
                </p>
                <h2 class="mt-2 max-w-xl font-heading text-3xl font-semibold leading-tight md:text-4xl">
                    La promoción se calcula automáticamente
                </h2>
                <p class="mt-4 max-w-2xl text-sm leading-relaxed text-sunka-white/86 md:text-base">
                    Agrega los productos al carrito y te mostraremos la mejor promoción aplicable.
                    Las combinaciones tienen prioridad sobre el beneficio por monto.
                </p>
            </div>
            <a
                href="/tienda"
                class="inline-flex h-11 shrink-0 items-center justify-center border border-sunka-brass bg-sunka-brass px-6 text-[12px] font-semibold uppercase tracking-[0.12em] text-sunka-white transition-colors duration-300 hover:bg-sunka-brass-light hover:text-sunka-ink"
            >
                Comenzar mi compra
            </a>
        </div>
    </section>
</BaseLayout>

<style>
    .linea-hero-image {
        animation: lineaHeroZoom 12s ease-in-out infinite alternate;
    }

    @keyframes lineaHeroZoom {
        from {
            transform: scale(1);
        }

        to {
            transform: scale(1.06);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .linea-hero-image {
            animation: none;
        }
    }
</style>
