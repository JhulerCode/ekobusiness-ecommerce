---
import BaseLayout from '@/layouts/BaseLayout.astro'
import LineaHero from '@/components/lineas/LineaHero.astro'
import LineaMomentos from '@/components/lineas/LineaMomentos.astro'
import LineaProductosDestacados from '@/components/lineas/LineaProductosDestacados.astro'
import LineaIdealParaTi from '@/components/lineas/LineaIdealParaTi.astro'
import LineaDiferencia from '@/components/lineas/LineaDiferencia.astro'
import LineaPreparacion from '@/components/lineas/LineaPreparacion.astro'
import { getLineaBySlug } from '@/data/lineas'
import { serverGet as get } from '@/lib/server/public-api'

const lineaConfig = getLineaBySlug(Astro.params.slug || '')

if (!lineaConfig) {
    return Astro.rewrite('/404')
}

const productosDestacadosIds = lineaConfig.productosDestacadosIds ?? []
let productosDestacados: Array<Record<string, any>> = []

if (productosDestacadosIds.length > 0) {
    const productosResponse = await get('productos', { ids: productosDestacadosIds })
    const productosById = new Map(
        (productosResponse.ok ? productosResponse.data ?? [] : []).map(
            (producto: Record<string, any>) => [producto.id, producto],
        ),
    )

    productosDestacados = productosDestacadosIds
        .map((id: string) => productosById.get(id))
        .filter(Boolean)
        .map((producto: Record<string, any>) => {
            const ecommerceData = producto.ecommerce_data ?? {}
            const fotoPrincipal = ecommerceData.fotos?.[0]

            return {
                id: producto.id,
                // ...ecommerceData,
                nombre: ecommerceData.name,
                perfil: ecommerceData.descripcion,
                image: fotoPrincipal?.url,
                imageAlt: fotoPrincipal?.name ?? ecommerceData.name,
                href: `/productos/${producto.id}`,
            }
        })
}

const linea = { ...lineaConfig, productosDestacados }
---

<BaseLayout title={linea.seoTitle}>
    <LineaHero linea={linea} />
    <LineaMomentos linea={linea} />
    <LineaProductosDestacados linea={linea} />
    <LineaDiferencia linea={linea} />
    <LineaPreparacion />
    <LineaIdealParaTi linea={linea} />
</BaseLayout>
