---
import BaseLayout from '@/layouts/BaseLayout.astro'
import ConsultaPedidoForm from '@/components/ConsultaPedidoForm.vue'
import BotanicalBranch from '@/assets/icons/icon-botanical-branch.astro'
import empresa from '@/data/company.js'
---

<BaseLayout title="Consulta tu pedido | SUNKA Herbal Tea">
    <section class="relative overflow-hidden bg-sunka-forest text-sunka-white">
        <div
            class="absolute -right-32 top-16 h-[440px] w-[440px] rounded-full border border-sunka-brass/15"
            aria-hidden="true"
        ></div>
        <div
            class="absolute -right-8 top-40 h-64 w-64 rounded-full bg-sunka-brass/5"
            aria-hidden="true"
        ></div>
        <BotanicalBranch
            class="absolute -bottom-20 -left-20 h-96 w-96 rotate-12 text-sunka-brass opacity-[0.07]"
            aria-hidden="true"
        />

        <div
            class="relative mx-auto grid min-h-[690px] max-w-7xl items-center gap-12 px-5 pb-20 pt-40 md:px-8 lg:grid-cols-[minmax(0,1fr)_480px] lg:gap-20 lg:pt-36"
        >
            <div class="max-w-2xl">
                <a
                    href="/tienda"
                    class="mb-8 inline-flex items-center gap-2 text-[11px] text-sunka-white/55 transition-colors hover:text-sunka-brass-light"
                >
                    <span aria-hidden="true">←</span>
                    Volver a la tienda
                </a>

                <p
                    class="text-[10px] font-semibold uppercase tracking-[0.25em] text-sunka-brass-light"
                >
                    Seguimiento de compra
                </p>
                <h1
                    class="mt-5 max-w-xl font-heading text-4xl font-semibold leading-[1.05] md:text-5xl lg:text-6xl"
                >
                    Tu pedido, siempre a la vista
                </h1>
                <p class="mt-7 max-w-lg text-sm leading-7 text-sunka-white/65 md:text-base">
                    Consulta el avance de tu compra y revisa todos sus detalles desde un solo lugar.
                    Solo necesitas el número que enviamos a tu correo.
                </p>

                <div class="mt-10 grid max-w-lg gap-5 border-t border-sunka-white/10 pt-7 sm:grid-cols-2">
                    <div>
                        <span class="text-[9px] font-bold uppercase tracking-[0.16em] text-sunka-brass-light">
                            Consulta inmediata
                        </span>
                        <p class="mt-2 text-xs leading-relaxed text-sunka-white/55">
                            Revisa el estado actual de tu pedido en pocos segundos.
                        </p>
                    </div>
                    <div>
                        <span class="text-[9px] font-bold uppercase tracking-[0.16em] text-sunka-brass-light">
                            Información segura
                        </span>
                        <p class="mt-2 text-xs leading-relaxed text-sunka-white/55">
                            Accede directamente a los datos asociados a tu compra.
                        </p>
                    </div>
                </div>
            </div>

            <ConsultaPedidoForm client:load empresa={empresa} />
        </div>
    </section>

    <section class="bg-sunka-cream">
        <div class="mx-auto grid max-w-7xl gap-7 px-5 py-10 md:grid-cols-3 md:px-8 md:py-12">
            <article class="border-l-2 border-sunka-brass pl-5">
                <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-sunka-brass">
                    01 · Ten tu código a mano
                </p>
                <p class="mt-2 text-xs leading-relaxed text-sunka-stone">
                    Lo encontrarás en el correo de confirmación de tu compra.
                </p>
            </article>
            <article class="border-l-2 border-sunka-brass pl-5">
                <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-sunka-brass">
                    02 · Seguimiento actualizado
                </p>
                <p class="mt-2 text-xs leading-relaxed text-sunka-stone">
                    Consulta cada etapa, desde la recepción hasta la entrega.
                </p>
            </article>
            <article class="border-l-2 border-sunka-brass pl-5">
                <p class="text-[9px] font-bold uppercase tracking-[0.16em] text-sunka-brass">
                    03 · Estamos para ayudarte
                </p>
                <p class="mt-2 text-xs leading-relaxed text-sunka-stone">
                    Si tienes alguna duda, nuestro equipo puede orientarte.
                </p>
            </article>
        </div>
    </section>
</BaseLayout>
