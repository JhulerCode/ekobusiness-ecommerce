---
import LeafIcon from '@/assets/icons/icon-leaf.astro'
import BotanicalIcon from '@/assets/icons/icon-botanical-mix.astro'
import RitualIcon from '@/assets/icons/icon-ritual-goal.astro'
import GiftIcon from '@/assets/icons/icon-gift.astro'
import DropIcon from '@/assets/icons/icon-drop.astro'
import LotusIcon from '@/assets/icons/icon-lotus.astro'
import MountainIcon from '@/assets/icons/icon-mountain.astro'
import PersonalPackIcon from '@/assets/icons/icon-personal-pack.astro'
import ThreeLeafSproutIcon from '@/assets/icons/icon-three-leaf-sprout.astro'
import BotanicalBranchIcon from '@/assets/icons/icon-botanical-branch.astro'

const { linea } = Astro.props
const ideal = linea.idealPara

const icons = {
    leaf: LeafIcon,
    botanical: BotanicalIcon,
    ritual: RitualIcon,
    gift: GiftIcon,
    drop: DropIcon,
    lotus: LotusIcon,
    mountain: MountainIcon,
    personal: PersonalPackIcon,
}
---

<section id="ideal-para-ti" class="ideal-section relative overflow-hidden bg-[#f5ecdc] py-14 text-sunka-ink md:py-20 lg:py-24">
    <BotanicalBranchIcon class="absolute -right-8 -top-2 h-auto w-64 text-sunka-brass opacity-[0.13] md:w-80 lg:w-[380px]" aria-hidden="true" />
    <BotanicalBranchIcon class="absolute -bottom-16 -left-20 h-auto w-64 -scale-x-100 rotate-[12deg] text-sunka-brass opacity-[0.08] md:w-72" aria-hidden="true" />

    <div class="relative mx-auto max-w-7xl px-5 md:px-8">
        <header class="mx-auto max-w-3xl text-center">
            <h2 class="font-heading text-3xl font-semibold leading-tight md:text-4xl">
                {ideal.title}
            </h2>
            <div class="mx-auto mt-5 flex items-center justify-center gap-2 text-sunka-brass" aria-hidden="true">
                <span class="h-px w-14 bg-sunka-brass/70"></span>
                <ThreeLeafSproutIcon class="h-5 w-5" />
                <span class="h-px w-14 bg-sunka-brass/70"></span>
            </div>
            <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-sunka-ink/80 md:text-base">
                {ideal.description}
            </p>
        </header>

        <div class={`mt-10 grid gap-5 md:mt-12 ${ideal.points.length === 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3'}`}>
            {
                ideal.points.map((point) => {
                    const item = typeof point === 'string' ? { title: point, text: '', icon: 'leaf' } : point
                    const Icon = icons[item.icon] ?? LeafIcon

                    return (
                        <article class="flex min-h-[285px] flex-col items-center rounded-[20px] border border-sunka-brass/35 bg-[#fffdf8]/90 px-5 py-7 text-center shadow-[0_12px_28px_rgba(73,48,17,.11)] lg:min-h-[305px] lg:px-6">
                            <span class="flex h-20 w-20 items-center justify-center rounded-full border border-sunka-brass/55 text-sunka-brass">
                                <Icon class="h-10 w-10" aria-hidden="true" />
                            </span>
                            <h3 class="mt-5 font-heading text-xl font-semibold leading-tight">
                                {item.title}
                            </h3>
                            <span class="mt-4 flex items-center gap-1.5 text-sunka-brass" aria-hidden="true">
                                <span class="h-px w-5 bg-sunka-brass/70"></span>
                                <span class="h-1.5 w-1.5 rounded-full bg-sunka-brass"></span>
                                <span class="h-px w-5 bg-sunka-brass/70"></span>
                            </span>
                            <p class="mt-4 text-sm leading-relaxed text-sunka-ink/72">
                                {item.text}
                            </p>
                        </article>
                    )
                })
            }
        </div>

        <div class="mt-9 text-center md:mt-11">
            <a
                href={`/tienda?linea=${encodeURIComponent(linea.slug)}`}
                class="inline-flex h-11 items-center justify-center border border-sunka-brass bg-sunka-brass px-6 text-[12px] font-semibold uppercase tracking-[0.12em] text-sunka-white transition-colors duration-300 hover:bg-sunka-brass-light hover:text-sunka-ink"
            >
                Ver coleccion completa
            </a>
        </div>
    </div>
</section>

<style>
    .ideal-section {
        background-image:
            radial-gradient(circle at 18% 28%, rgba(181, 139, 71, 0.08), transparent 26%),
            radial-gradient(circle at 78% 72%, rgba(181, 139, 71, 0.07), transparent 30%);
    }
</style>
