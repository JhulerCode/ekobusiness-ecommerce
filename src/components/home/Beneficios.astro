---
import LeafIcon from '@/assets/icons/icon-leaf.astro'
import ShieldIcon from '@/assets/icons/icon-shield-check.astro'
import HeartIcon from '@/assets/icons/icon-heart-origin.astro'
---

<section class="bg-sunka-cream">
    <div class="mx-auto max-w-7xl border-b border-sunka-sand/70 px-5 py-9 md:px-8 md:py-10">
        <h2 class="text-center font-heading text-2xl font-medium tracking-[-0.02em] text-sunka-ink md:text-3xl">
            Comprar también puede ser parte del ritual.
        </h2>

        <div class="mt-8 grid grid-cols-1 gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-10">
            <article class="group flex items-start gap-3.5 fade-up" style="transition-delay: 0.1s">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center text-sunka-olive">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.4"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-8 w-8 opacity-80"
                        aria-hidden="true"
                    >
                        <path d="M7 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                        <path d="M17 17m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                        <path d="M5 17h-2v-11a1 1 0 0 1 1 -1h9v12m-4 0h6m4 0h2v-6h-8m0 -5h5l3 5" />
                    </svg>
                </div>
                <div>
                    <h3 class="font-heading text-sm font-semibold leading-tight text-sunka-ink">
                        Envío consciente
                    </h3>
                    <p class="mt-1.5 text-[11px] leading-[1.45] text-sunka-ink/65">
                        Envío gratuito en compras mayores a S/ 30.
                    </p>
                </div>
            </article>

            <article class="group flex items-start gap-3.5 fade-up" style="transition-delay: 0.2s">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center text-sunka-olive transition-transform duration-300 group-hover:-translate-y-1">
                    <LeafIcon class="h-8 w-8" aria-hidden="true" />
                </div>
                <div>
                    <h3 class="font-heading text-sm font-semibold leading-tight text-sunka-ink">
                        Selección natural
                    </h3>
                    <p class="mt-1.5 text-[11px] leading-[1.45] text-sunka-ink/65">
                        Ingredientes seleccionados cuidadosamente.
                    </p>
                </div>
            </article>

            <article class="group flex items-start gap-3.5 fade-up" style="transition-delay: 0.3s">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center text-sunka-olive transition-transform duration-300 group-hover:-translate-y-1">
                    <ShieldIcon class="h-8 w-8" aria-hidden="true" />
                </div>
                <div>
                    <h3 class="font-heading text-sm font-semibold leading-tight text-sunka-ink">Compra segura</h3>
                    <p class="mt-1.5 text-[11px] leading-[1.45] text-sunka-ink/65">
                        Métodos de pago confiables y proceso protegido.
                    </p>
                </div>
            </article>

            <article class="group flex items-start gap-3.5 fade-up" style="transition-delay: 0.4s">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center text-sunka-olive transition-transform duration-300 group-hover:-translate-y-1">
                    <HeartIcon class="h-8 w-8" aria-hidden="true" />
                </div>
                <div>
                    <h3 class="font-heading text-sm font-semibold leading-tight text-sunka-ink">Calidad SUNKA</h3>
                    <p class="mt-1.5 text-[11px] leading-[1.45] text-sunka-ink/65">
                        Cada mezcla elaborada bajo nuestros estándares de calidad ritual.
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>
