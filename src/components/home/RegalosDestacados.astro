---
import { formatProductos } from '@/lib/api'
import { formatProductPrice, getProductPrice, hasClubPrice } from '@/lib/pricing'
import { serverGet as get } from '@/lib/server/public-api'

const isAuthenticated = Astro.locals.session?.status === 'authenticated'

const qry2 = {
    fltr: {
        activo: { op: 'Es', val: true },
        is_ecommerce: { op: 'Es', val: true },
    },
    cols: ['id', 'linea', 'categoria', 'ecommerce_data'],
}

const res2 = await get('productos', { qry: qry2 })
const productos = formatProductos(res2.ok ? res2.data : [])
    .filter((producto) => producto.is_destacado)
    .slice(0, 6)
---

<section class="bg-sunka-cream py-9 text-sunka-ink md:py-11">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="mb-5 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
                <h2 class="font-heading text-2xl font-semibold leading-tight md:text-3xl">
                    Productos destacados
                </h2>
                <p class="mt-1 text-sm leading-relaxed text-sunka-ink/68">
                    Descubre productos seleccionados para tu bienestar.
                </p>
            </div>

            <a
                href="/tienda"
                class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.1em] text-sunka-ink transition hover:text-sunka-brass"
            >
                Ver todos los productos
                <span aria-hidden="true">&rarr;</span>
            </a>
        </div>

        {
            productos.length > 0 && (
                <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6 lg:gap-7">
                    {productos.map((producto) => (
                        <a
                            href={`/productos/${producto.slug}`}
                            class="group block overflow-hidden rounded-[6px] border border-sunka-ink/14  shadow-[0_1px_0_rgba(9,8,6,0.05)] transition hover:border-sunka-brass/45"
                        >
                            <div class="aspect-[4/4] overflow-hidden bg-sunka-sand">
                                {producto.foto && (
                                    <img
                                        src={producto.foto}
                                        alt={producto.nombre}
                                        loading="lazy"
                                        class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                                    />
                                )}
                            </div>

                            <div class="min-h-[58px] px-3 py-2 text-center">
                                <h3 class="truncate text-sm font-semibold leading-tight text-sunka-ink">
                                    {producto.nombre}
                                </h3>
                                <div class="mt-0.5 flex flex-wrap items-baseline justify-center gap-x-2 gap-y-0.5">
                                    <p class="text-sm font-medium leading-tight text-sunka-ink">
                                        S/ {formatProductPrice(getProductPrice(producto, isAuthenticated))}
                                    </p>
                                    {
                                        hasClubPrice(producto) && (
                                            <p class="text-[10px] leading-tight text-sunka-stone">
                                                {isAuthenticated
                                                    ? `Regular: S/ ${formatProductPrice(producto.precio)}`
                                                    : `Club: S/ ${formatProductPrice(producto.precio_club)}`}
                                            </p>
                                        )
                                    }
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</section>
