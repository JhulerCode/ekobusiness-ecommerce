---
import hero from '@/assets/home/banner/chica.webp'
import teapot from '@/assets/home/banner/tetera.webp'
import ritualPause from '@/assets/home/campo.webp'
import ritualDetail from '@/assets/home/lineas/piramidal.webp'
import ritualBlend from '@/assets/home/blend.webp'
import tradicional from '@/assets/home/lineas/tradicional.webp'
import signature from '@/assets/home/lineas/signature.webp'
import premium from '@/assets/home/lineas/piramidal.webp'
import luxury from '@/assets/home/lineas/luxury.webp'
import peru from '@/assets/home/banner/tazas.webp'

const principles = [
    ['01', 'Calidad sin concesiones', 'Ingredientes seleccionados y procesos cuidados para una experiencia consistente.'],
    ['02', 'Innovación constante', 'Blends y formatos creados para una vida que siempre está cambiando.'],
    ['03', 'Orgullo peruano', 'Creada en Perú, con identidad propia y una visión que mira hacia el mundo.'],
]

const collections = [
    ['Todos los días', 'Tradicionales', 'Tu ritual diario.', tradicional],
    ['Una pausa superior', 'Signature Black', 'Tés de autoría.', signature],
    ['Blends con intención', 'Piramidal Premium', 'Ingredientes visibles.', premium],
    ['La máxima expresión', 'Luxury Collection', 'Creaciones especiales.', luxury],
]
---

<div class="origin-page bg-sunka-cream text-sunka-ink">
    <section class="hero relative min-h-[690px] overflow-hidden text-sunka-white md:min-h-[760px]">
        <img src={hero.src} alt="Mujer disfrutando una infusión SUNKA" class="absolute inset-0 h-full w-full object-cover object-[62%_center]" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(4,7,5,.94)_0%,rgba(4,7,5,.76)_42%,rgba(4,7,5,.1)_78%)]"></div>
        <div class="relative mx-auto flex min-h-[690px] max-w-7xl items-center px-5 pb-16 pt-28 md:min-h-[760px] md:px-8 md:pt-32">
            <div class="max-w-3xl fade-up">
                <p class="kicker">Nuestra historia</p>
                <h1 class="serif mt-7 text-5xl font-semibold leading-[.94] tracking-[-.035em] sm:text-6xl lg:text-[78px]">Una marca creada<br />para trascender.</h1>
                <p class="mt-10 max-w-xl text-base font-light leading-7 text-sunka-white/82 md:text-lg">Sunka es una marca peruana de té e infusiones que combina calidad e innovación para acompañarte en cada momento de tu día.</p>
                <div class="mt-9 flex flex-col gap-3 sm:flex-row"><a href="/tienda" class="button-origin bg-sunka-brass text-sunka-ink hover:bg-sunka-brass-light">Descubre nuestras colecciones</a><a href="#historia" class="button-origin border border-sunka-white/55 text-sunka-white hover:bg-sunka-white hover:text-sunka-ink">Conoce nuestra esencia</a></div>
                <a href="#historia" class="mt-16 inline-flex items-center gap-4 text-[10px] font-semibold uppercase tracking-[.28em] text-sunka-white/65"><span class="h-px w-12 bg-sunka-brass"></span>Sigue nuestra historia</a>
            </div>
        </div>
    </section>

    <section id="historia" class="py-24 md:py-36">
        <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 md:grid-cols-2 md:px-8 lg:gap-24">
            <div class="relative mx-auto w-full max-w-[540px] fade-up"><div class="absolute -bottom-5 -left-5 h-[90%] w-[55%] border border-sunka-brass/35"></div><img src={teapot.src} alt="Tetera SUNKA sobre una mesa" class="relative aspect-[1.08] w-full object-cover object-[68%_center]" /></div>
            <div class="fade-up delay-1"><p class="kicker text-sunka-brass">El origen de Sunka</p><h2 class="serif mt-6 max-w-xl text-4xl font-semibold leading-[1.02] tracking-[-.02em] md:text-6xl">Nacimos para crear algo que permanezca.</h2><p class="mt-10 max-w-lg text-lg leading-8 text-sunka-ink/72">Sunka nació de una convicción: lo cotidiano también puede dejar huella.</p><p class="mt-5 max-w-lg leading-7 text-sunka-ink/62">Por eso transformamos una taza de té en una experiencia que evoluciona contigo. Seleccionamos, desarrollamos y presentamos cada producto con una mirada contemporánea, cuidando lo que se siente hoy y lo que representará mañana.</p><p class="mt-9 flex items-center gap-4 text-[10px] font-semibold uppercase tracking-[.26em]"><span class="h-px w-12 bg-sunka-brass"></span>The soul of tea</p></div>
        </div>
    </section>

    <section class="border-y border-sunka-ink/10 bg-sunka-white py-24 md:py-32">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
            <div class="mx-auto max-w-3xl text-center fade-up"><p class="kicker text-sunka-brass">Lo que nos mueve</p><h2 class="serif mt-6 text-4xl font-semibold leading-none tracking-[-.02em] md:text-6xl">Tres principios. Una sola forma<br class="hidden md:block" /> de hacer las cosas.</h2><p class="mx-auto mt-8 max-w-2xl leading-7 text-sunka-ink/58">Nuestra historia se construye con decisiones concretas: elevar la calidad, innovar con propósito y demostrar todo lo que una marca peruana puede llegar a ser.</p></div>
            <div class="mt-16 grid border-y border-sunka-ink/12 md:grid-cols-3">{principles.map((item, index) => <article class:list={['px-6 py-10 md:px-9 md:py-12 fade-up', index > 0 && 'border-t border-sunka-ink/12 md:border-l md:border-t-0']}><p class="text-[10px] font-semibold tracking-[.25em] text-sunka-brass">{item[0]}</p><h3 class="serif mt-7 text-2xl font-semibold">{item[1]}</h3><p class="mt-4 max-w-sm text-sm leading-6 text-sunka-ink/58">{item[2]}</p></article>)}</div>
        </div>
    </section>

    <section class="bg-sunka-forest py-24 text-sunka-white md:py-32">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
            <div class="grid gap-8 md:grid-cols-[1.2fr_.8fr] md:items-end"><div class="fade-up"><p class="kicker text-sunka-brass-light">Sunka en tu día</p><h2 class="serif mt-6 text-4xl font-semibold leading-none md:text-6xl">Hay una forma de acompañar<br class="hidden lg:block" /> cada momento.</h2></div><p class="max-w-md leading-7 text-sunka-white/62 fade-up delay-1">No creemos en una única manera de vivir el té. Creamos opciones para tus mañanas, tus pausas y esos momentos que eliges compartir.</p></div>
            <div class="mt-16 grid auto-rows-[250px] gap-3 md:grid-cols-5 md:auto-rows-[290px]"><a href="/rituales" class="card md:col-span-3 md:row-span-2"><img src={ritualPause.src} alt="Pausa con té SUNKA" /><div></div><span><small>Tu pausa</small><strong>Un instante que vuelve a ser tuyo.</strong></span></a><a href="/rituales" class="card md:col-span-2"><img src={ritualDetail.src} alt="Preparación de té piramidal" /><div></div><span><small>Tu ritual</small><strong>Calidad que se siente.</strong></span></a><a href="/crea-tu-blend" class="card md:col-span-2"><img src={ritualBlend.src} alt="Ingredientes de infusiones" /><div></div><span><small>Tu creación</small><strong>Una mezcla a tu manera.</strong></span></a></div>
        </div>
    </section>

    <section class="bg-sunka-white py-24 md:py-32">
        <div class="mx-auto max-w-7xl px-5 md:px-8">
            <div class="grid gap-8 md:grid-cols-[1.2fr_.8fr] md:items-end"><div class="fade-up"><p class="kicker text-sunka-brass">Una marca en evolución</p><h2 class="serif mt-6 text-4xl font-semibold leading-none md:text-6xl">De lo cotidiano a<br />lo extraordinario.</h2></div><p class="max-w-md leading-7 text-sunka-ink/58 fade-up delay-1">Creamos distintas colecciones para acompañarte hoy y seguir evolucionando contigo mañana.</p></div>
            <div class="mt-16 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{collections.map((item) => <a href="/tienda" class="card aspect-[.72] fade-up"><img src={item[3].src} alt={item[1]} /><div></div><span><small>{item[0]}</small><strong>{item[1]}</strong><em>{item[2]}</em></span></a>)}</div>
        </div>
    </section>

    <section class="relative min-h-[600px] overflow-hidden text-sunka-white md:min-h-[670px]"><img src={peru.src} alt="Tazas SUNKA bajo el cielo del Perú" class="absolute inset-0 h-full w-full object-cover object-[68%_center]" /><div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(3,14,11,.92)_0%,rgba(3,14,11,.62)_48%,rgba(3,14,11,.08)_82%)]"></div><div class="relative mx-auto flex min-h-[600px] max-w-7xl items-center px-5 py-24 md:min-h-[670px] md:px-8"><div class="max-w-3xl fade-up"><p class="kicker text-sunka-brass-light">Marca peruana</p><h2 class="serif mt-6 text-4xl font-semibold leading-[1.02] md:text-6xl">Desde Perú, con una visión<br class="hidden md:block" /> que mira al mundo.</h2><p class="mt-10 max-w-2xl text-base leading-8 text-sunka-white/72">Aquí nace nuestra historia. De nuestra creatividad, exigencia y capacidad de reinventarnos. Sunka se construye para representar una nueva generación de marcas peruanas: contemporáneas, relevantes y preparadas para trascender fronteras.</p><p class="mt-10 flex items-center gap-4 text-[10px] font-semibold uppercase tracking-[.26em]"><span class="h-px w-12 bg-sunka-brass"></span>Creado en Perú</p></div></div></section>

    <section class="bg-[#10120f] px-5 py-24 text-center text-sunka-white md:px-8 md:py-32"><div class="mx-auto max-w-5xl fade-up"><p class="kicker text-sunka-brass-light">Nuestro propósito</p><h2 class="serif mt-8 text-3xl font-medium leading-[1.18] md:text-5xl">Queremos estar presentes en tu vida de una forma sencilla: haciendo que cada taza se sienta mejor, se recuerde más y <span class="text-sunka-brass-light">permanezca en el tiempo.</span></h2><p class="mt-8 text-sm text-sunka-white/50">Hoy te acompañamos en una infusión. Mañana, en nuevas formas de vivir el té.</p><div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"><a href="/tienda" class="button-origin bg-sunka-brass text-sunka-ink hover:bg-sunka-brass-light">Explorar la tienda</a><a href="/crea-tu-blend" class="button-origin border border-sunka-white/40 hover:bg-sunka-white hover:text-sunka-ink">Crear mi blend</a></div></div></section>
</div>

<style>
    .origin-page { --origin-serif: Georgia, 'Times New Roman', serif; }
    .serif { font-family: var(--origin-serif); }
    .kicker { font-size: 10px; font-weight: 600; letter-spacing: .3em; text-transform: uppercase; }
    .button-origin { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; padding: 0 24px; font-size: 10px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; transition: .25s ease; }
    .card { position: relative; display: block; overflow: hidden; color: var(--sunka-white); }
    .card > img { height: 100%; width: 100%; object-fit: cover; transition: transform .7s ease; }
    .card:hover > img { transform: scale(1.035); }
    .card > div { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 34%, rgba(2, 4, 3, .82) 100%); }
    .card > span { position: absolute; right: 24px; bottom: 24px; left: 24px; display: flex; flex-direction: column; }
    .card small { margin-bottom: 8px; color: var(--sunka-brass-light); font-size: 9px; font-style: normal; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
    .card strong { font-family: var(--origin-serif); font-size: 24px; line-height: 1.08; }
    .card em { margin-top: 6px; color: rgba(255, 253, 248, .68); font-size: 12px; font-style: normal; }
    @media (max-width: 767px) { .origin-page h1, .origin-page h2 { text-wrap: balance; } }
</style>
