---
const { number, title } = Astro.props
---

<div class="mb-5 flex items-center gap-3">
    <span
        class="grid h-8 w-8 place-items-center rounded-full bg-sunka-forest text-[10px] font-bold text-sunka-brass-light"
    >
        {number}
    </span>
    <h3 class="font-heading text-lg font-semibold text-sunka-forest">{title}</h3>
</div>
